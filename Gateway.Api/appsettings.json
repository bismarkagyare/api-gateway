{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimit": {
    "MaxRequests": 5,
    "WindowSeconds": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Downstream": {
    "Routes": [
      {
        "Path": "products",
        "Target": "http://localhost:5099"
      },
      {
        "Path": "orders",
        "Target": "http://localhost:5101"
      }
    ]
  },
  "AllowedHosts": "*"
}